<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs once on a developer machine to compute the embeddings. The page never uses it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EmbeddingMap.Core\EmbeddingMap.Core.csproj" />
  </ItemGroup>

</Project>
